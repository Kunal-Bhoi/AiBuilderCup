# Default: connect to the existing backend through Vite's development proxy.
VITE_USE_MOCK=false
VITE_API_BASE_URL=/api/v1
VITE_PROXY_TARGET=http://localhost:8080
# Matches the backend's local AUTH_MODE=dev. Production must use firebase.
VITE_AUTH_MODE=dev
# For a standalone demo instead, use VITE_USE_MOCK=true.
